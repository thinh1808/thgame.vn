{
  "name": "thgame-admin",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "thgame.vn/admin*",
      "zone_name": "thgame.vn"
    },
    {
      "pattern": "www.thgame.vn/admin*",
      "zone_name": "thgame.vn"
    }
  ],
  "assets": {
    "directory": "../private-dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://thgame.vn",
    "ALLOWED_GITHUB_ID": "22042427"
  }
}
